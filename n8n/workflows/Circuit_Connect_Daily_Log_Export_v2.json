      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst rows = response.data || [];\nconst SHEET_IDS = [\n  '1olVJevWWuNakgCXh_Po3Q6c1TgiDPyQo0qqU0a5n-nQ',\n  '1ewR0cU9ydhd8DOV8zba8Al66kiwt1lJsXhDTZK1x0zc',\n  '1c7hfq7FcEP9CP-ZvZhWV2j2it_0y0M4p0dwP_X41otQ'\n];\nconst MAX_ROWS = 900000;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.currentSheet) staticData.currentSheet = 0;\nif (!staticData.rowCount) staticData.rowCount = 0;\nstaticData.rowCount += rows.length;\nif (staticData.rowCount >= MAX_ROWS) {\n  staticData.currentSheet = Math.min(staticData.currentSheet + 1, SHEET_IDS.length - 1);\n  staticData.rowCount = rows.length;\n}\nconst targetSheetId = SHEET_IDS[staticData.currentSheet];\nstaticData._lastMeta = {\n  sheetNumber: staticData.currentSheet + 1,\n  rowsInserted: rows.length,\n  totalRows: staticData.rowCount\n};\nreturn rows.map(row => ({\n  json: {\n    ...row,\n    _targetSheetId: targetSheetId\n  }\n}));"
