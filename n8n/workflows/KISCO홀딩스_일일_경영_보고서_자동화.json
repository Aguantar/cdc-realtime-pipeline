      "id": "107b6786-1bb7-4ad0-9077-918b500a79d3",
      "name": "그룹 종합요약 추출 (CSV)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        208
      ],
      "notesInFlow": true,
      "notes": "Step 2-b: Query View Data → 그룹 합산매출/스프레드/평균원가율"
    },
    {
      "parameters": {
        "jsCode": "// Step 3: 데이터 가공 및 보고서 생성\n// 계열사별 CSV + 그룹요약 CSV → Slack/Email 보고서\n\nconst subsidiaryCSV = $('계열사별 일일지표 추출 (CSV)').first().json.data;\nconst summaryCSV = $('그룹 종합요약 추출 (CSV)').first().json.data;\n\n// CSV 파싱\nfunction parseCSV(csv) {\n  const lines = csv.trim().split('\\n');\n  const headers = lines[0].split(',');\n  return lines.slice(1).map(line => {\n    const values = line.split(',');\n    const obj = {};\n    headers.forEach((h, i) => obj[h.trim()] = values[i]?.trim());\n    return obj;\n  });\n}\n\nconst subs = parseCSV(subsidiaryCSV);\nconst summary = parseCSV(summaryCSV)[0];\n\n// 이상 감지\nconst alerts = [];\nconst subSections = subs.map(sub => {\n  const rev = parseFloat(sub.daily_revenue_m);\n  const prevRev = parseFloat(sub.prev_day_revenue_m);\n  const revChange = ((rev - prevRev) / prevRev * 100);\n  const costRatio = parseFloat(sub.cost_ratio);\n  const opRate = parseFloat(sub.operating_rate_pct);\n  const scrapPrice = parseInt(sub.scrap_price_kg);\n  const prevScrap = parseInt(sub.prev_week_scrap_price);\n  const scrapChange = scrapPrice - prevScrap;\n\n  if (costRatio > 0.90) alerts.push(`⚠️ ${sub.subsidiary}: 원가율 ${(costRatio*100).toFixed(1)}% 초과`);\n  if (opRate < 55) alerts.push(`⚠️ ${sub.subsidiary}: 가동률 ${opRate}% 저조`);\n  if (Math.abs(scrapChange) >= 10) alerts.push(`⚠️ ${sub.subsidiary}: 스크랩 ${scrapChange > 0 ? '+' : ''}${scrapChange}원/kg 급변동`);\n\n  const revArrow = revChange > 0 ? '🔺' : '🔻';\n  return `*${sub.subsidiary}*\\n  매출: ${rev}백만원 ${revArrow}(${revChange.toFixed(1)}%) | 원가율: ${(costRatio*100).toFixed(1)}% | 가동률: ${opRate}%`;\n});\n\n// 그룹 종합\nconst groupRev = parseFloat(summary.group_total_revenue_m);\nconst prevGroupRev = parseFloat(summary.prev_day_group_revenue_m);\nconst groupChange = ((groupRev - prevGroupRev) / prevGroupRev * 100);\nconst spread = parseFloat(summary.rebar_scrap_spread_k);\nconst prevSpread = parseFloat(summary.prev_week_spread_k);\n\nif (spread < 330) alerts.push(`🚨 스프레드 ${spread.toFixed(0)}천원/톤 마진압박`);\n\nconst reportDate = summary.date;\nconst now = new Date().toISOString().slice(0, 16).replace('T', ' ');\n\nconst slackMsg = `━━━━━━━━━━━━━━━━━━━━━━\\n📊 *KISCO홀딩스 일일 경영 보고서*\\n📅 ${reportDate} | 자동생성: ${now}\\n━━━━━━━━━━━━━━━━━━━━━━\\n\\n📈 *그룹 종합*\\n  합산매출: ${groupRev}백만원 (전일比 ${groupChange.toFixed(1)}%)\\n  평균원가율: ${(parseFloat(summary.group_avg_cost_ratio)*100).toFixed(1)}%\\n  스프레드: ${spread.toFixed(0)}천원/톤 (전주比 ${(spread-prevSpread).toFixed(0)})\\n\\n🏭 *계열사별*\\n${subSections.join('\\n\\n')}${alerts.length ? '\\n\\n⚠️ *이상감지 ' + alerts.length + '건*\\n' + alerts.join('\\n') : ''}\\n━━━━━━━━━━━━━━━━━━━━━━`;\n\nlet emailSubject = `[KISCO] ${reportDate} 일일 경영 보고서`;\nif (alerts.length) emailSubject += ` ⚠️ ${alerts.length}건`;\n\nreturn [{ json: { slack_message: slackMsg, email_subject: emailSubject, email_body: slackMsg, alerts_count: alerts.length } }];"
      },
