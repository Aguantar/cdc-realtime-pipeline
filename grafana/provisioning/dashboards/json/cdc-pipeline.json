      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "PDEE91DDB90597936"
      },
      "targets": [
        {
          "rawSql": "SELECT \n    market,\n    sum(bid_count) as bid,\n    sum(ask_count) as ask\nFROM cdc_pipeline.trade_aggregations \nWHERE window_start >= now() - INTERVAL 1 HOUR \nGROUP BY market \nORDER BY bid + ask DESC",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bid"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              },
              {
                "id": "displayName",
                "value": "매수 (BID)"
