          },
          {
            "matcher": {
              "id": "byName",
              "options": "ask"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E02F44"
                }
              },
              {
                "id": "displayName",
                "value": "매도 (ASK)"
