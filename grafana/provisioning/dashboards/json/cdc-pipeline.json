          "rawSql": "SELECT fromUnixTimestamp64Milli(updated_ms) AS time, symbol, side, strategy, status,\n       last_exec_type, toFloat64(price) AS price, version, reset_epoch\nFROM cdc_pipeline.virtual_orders FINAL\nWHERE is_deleted = 0 ORDER BY updated_ms DESC LIMIT 20",
